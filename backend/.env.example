# ---- Core ----
# PRODUCTION (free + permanent): Neon Postgres + Upstash Redis.
# Render's own free databases expire after 30 days (data loss) - do NOT use them for prod.
#   Neon      -> https://neon.tech      (free, serverless Postgres, persists forever)
#   Upstash   -> https://upstash.com    (free, Redis with TLS - works with Celery)
# Local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/ca_saas
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require
REDIS_URL=rediss://default:xxxx@us1-xxxx.upstash.io:6379
JWT_SECRET=replace-with-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 32-byte urlsafe base64 key for Fernet (AES-256 style envelope encryption)
FERNET_KEY=replace-with-fernet-key

# ---- Public URLs (same domain, different subdomains) ----
FRONTEND_URL=https://saas.ramyaai.tech
BACKEND_URL=https://api.ramyaai.tech
INBOUND_DOMAIN=inbound.ramyaai.tech
CORS_ORIGINS=["https://saas.ramyaai.tech","http://localhost:3000"]

# ---- Google OAuth + Gmail watch ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.ramyaai.tech/v1/gmail/oauth/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ---- Pipeline runner (no worker process needed on free tier) ----
# Default: the web service processes emails itself via BackgroundTasks.
# Only set WORKER_MODE=celery if you later add a paid dedicated worker.
WORKER_MODE=inline

# ---- Auth login with Google ----
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=https://saas.ramyaai.tech/auth/google/callback

# ---- Fallbacks (DB settings take precedence) ----
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_SYSTEM_PROMPT=
WHATSAPP_PROVIDER=meta
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_CONSULTANT=
WHATSAPP_TEMPLATE_CLIENT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
GUPSHUP_API_KEY=
GUPSHUP_SENDER=
